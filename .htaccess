<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # 1. Si la petición empieza con "api/", mandarla internamente a la carpeta public de Laravel
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^api/(.*)$ api/public/index.php [L]

    # 2. Para todo lo demás, si el archivo o carpeta física no existe, servir index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Prevenir que Cloudflare, proxies o navegadores almacenen en caché el cascarón HTML
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>